{
  "schema": "cann-analyze.repos.v1",
  "notes": "Adding a new repo is a catalog change, not a code change. Clone paths stay in catalogs/repos.local.json (gitignored) or --source. locate never clones.",
  "repos": [
    {
      "id": "cann/runtime",
      "org": "cann",
      "name": "runtime",
      "url": "https://gitcode.com/cann/runtime.git",
      "layer": "runtime",
      "role": "ACL, Runtime core, slog/dlog, adump, in-process profiling collector",
      "modules": ["RUNTIME", "ASCENDCL", "PROFILING", "TDT", "AICPU", "TPRT", "ATRACE", "ASYS"],
      "languages": ["c", "cpp"],
      "index_globs": ["src/**", "include/**", "pkg_inc/**"],
      "skip_globs": ["tests/**", "example/**", "third_party/**", "stub/**"],
      "msprof_roles": ["component", "collect"]
    },
    {
      "id": "ascend/msprof",
      "org": "Ascend",
      "name": "msprof",
      "url": "https://gitcode.com/Ascend/msprof.git",
      "layer": "toolchain",
      "role": "msprof collection CLI, parse/export/analyze, MindStudio profiler logs",
      "modules": ["PROFILING", "MSVP"],
      "languages": ["python", "cpp"],
      "index_globs": ["analysis/**", "src/**", "misc/**"],
      "skip_globs": ["test/**", "tests/**", "opensource/**", "build/**", "output/**"],
      "msprof_roles": ["collect", "parse"]
    },
    {
      "id": "ascend/msprof-analyze",
      "org": "Ascend",
      "name": "msprof-analyze",
      "url": "https://gitcode.com/Ascend/msprof-analyze.git",
      "layer": "toolchain",
      "role": "Post-collection bottleneck analysis on msprof dumps",
